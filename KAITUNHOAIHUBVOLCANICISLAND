--========================================================--
-- FPS
--========================================================--

local fps = 60
local fpsTimer = 0
local frameCount = 0

--========================================================--
-- SMOOTH UPDATE
--========================================================--

RunService.RenderStepped:Connect(function(dt)
	-- Main drag smoothing
	local moveAlpha = math.clamp(dt * 22, 0, 1)
	Main.Position = Main.Position:Lerp(targetPosition, moveAlpha)

	-- Status drag smoothing
	local statusAlpha = math.clamp(dt * 22, 0, 1)
	StatusBar.Position = StatusBar.Position:Lerp(statusTargetPosition, statusAlpha)

	-- FPS
	frameCount += 1
	fpsTimer += dt

	if fpsTimer >= 1 then
		fps = frameCount
		frameCount = 0
		fpsTimer = 0

		local playersCount = #Players:GetPlayers()

		BottomInfo.Text =
			"Ping: --    FPS: "
			.. tostring(fps)
			.. "    Players: "
			.. tostring(playersCount)
	end
end)

