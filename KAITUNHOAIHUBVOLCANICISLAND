-- AUTO SELECT MARINES
--========================================================
-- Chạy ngầm, KHÔNG thay đổi STATUS
-- STATUS vẫn giữ "Waiting..."

task.spawn(function()

	if not game:IsLoaded() then
		game.Loaded:Wait()
	end

	local Remotes =
		ReplicatedStorage:WaitForChild(
			"Remotes",
			30
		)

	if not Remotes then
		warn("HOÀI HUB: Remotes not found")
		return
	end

	local CommF_ =
		Remotes:WaitForChild(
			"CommF_",
			30
		)

	if not CommF_ then
		warn("HOÀI HUB: CommF_ not found")
		return
	end

	-- Đã có team thì không làm gì
	if LocalPlayer.Team then
		return
	end

	-- Tự chọn Marines
	local Deadline = os.clock() + 15

	while LocalPlayer.Parent
		and LocalPlayer.Team == nil
		and os.clock() < Deadline do

		pcall(function()

			CommF_:InvokeServer(
				"SetTeam",
				"Marines"
			)

		end)

		task.wait(0.5)

	end

	if LocalPlayer.Team then
		print(
			"HOÀI HUB: Team = "
				.. LocalPlayer.Team.Name
		)
	else
		warn(
			"HOÀI HUB: Marine selection failed"
		)
	end

end)

