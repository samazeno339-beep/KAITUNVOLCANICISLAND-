--========================================================
-- WORKSPACE OBJECT MỚI
--========================================================

Workspace.DescendantAdded:Connect(function(Object)

	task.defer(function()

		if not Object.Parent then
			return
		end

		OptimizeObject(Object)

		-- Nếu thuộc NPC thì xử lý cosmetic
		local Character = Object:FindFirstAncestorOfClass("Model")

		if Character
			and Character:FindFirstChildOfClass("Humanoid") then

			HideNPCClothes(Character)

		end

	end)

end)

