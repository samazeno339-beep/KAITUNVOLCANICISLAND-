_G.HoaiHubSetStatus = SetStatus

--================================================
-- KAITUN TOGGLE
--================================================

local KaitunEnabled = false

local function UpdateKaitunButton()
	if KaitunEnabled then

		KaitunButton.Text = "KAITUN : ON"
		KaitunButton.BackgroundColor3 = CONFIG.ButtonOn
		KaitunButton.TextColor3 = Color3.fromRGB(255, 245, 255)

	else

		KaitunButton.Text = "KAITUN : OFF"
		KaitunButton.BackgroundColor3 = CONFIG.ButtonOff
		KaitunButton.TextColor3 = Color3.fromRGB(225, 210, 240)

	end
end

KaitunButton.MouseButton1Click:Connect(function()

	KaitunEnabled = not KaitunEnabled

	UpdateKaitunButton()

	if KaitunEnabled then
		SetStatus("Kaitun Enabled")
	else
		SetStatus("Kaitun Disabled")
	end

end)

--================================================
-- PURPLE GLOW
--================================================

task.spawn(function()

	while Main.Parent do

		local t1 = TweenService:Create(
			Border,
			TweenInfo.new(
				1.2,
				Enum.EasingStyle.Sine,
				Enum.EasingDirection.InOut
			),
			{
				Thickness = 3,
				Color = CONFIG.AccentLight
			}
		)

		t1:Play()
		t1.Completed:Wait()

		local t2 = TweenService:Create(
			Border,
			TweenInfo.new(
				1.2,
				Enum.EasingStyle.Sine,
				Enum.EasingDirection.InOut
			),
			{
				Thickness = 2,
				Color = CONFIG.Accent
			}
		)

		t2:Play()
		t2.Completed:Wait()

	end

end)

