--========================================================
-- NPC COSMETICS
--========================================================

local function GetHumanoid(Model)

	if not Model or not Model:IsA("Model") then
		return nil
	end

	return Model:FindFirstChildOfClass("Humanoid")
end

local function HideNPCCosmetics(Model)

	local Humanoid = GetHumanoid(Model)

	if not Humanoid then
		return
	end

	if Model == Player.Character then
		return
	end

	for _, Object in ipairs(Model:GetDescendants()) do

		if Object:IsA("Accessory") then

			for _, Part in ipairs(Object:GetDescendants()) do

				if Part:IsA("BasePart") then

					pcall(function()
						Part.LocalTransparencyModifier = 1
						Part.CastShadow = false
					end)

				elseif Part:IsA("Texture")
					or Part:IsA("Decal") then

					pcall(function()
						Part.Transparency = 1
					end)

				end
			end

		elseif Object:IsA("Shirt") then

			pcall(function()
				Object.ShirtTemplate = ""
			end)

		elseif Object:IsA("Pants") then

			pcall(function()
				Object.PantsTemplate = ""
			end)

		elseif Object:IsA("ShirtGraphic") then

			pcall(function()
				Object.Graphic = ""
			end)

		end
	end
end

for _, Object in ipairs(Workspace:GetChildren()) do

	if Object:IsA("Model") then
		HideNPCCosmetics(Object)
	end

end

Workspace.ChildAdded:Connect(function(Object)

	if Object:IsA("Model") then

		task.defer(function()
			HideNPCCosmetics(Object)
		end)

	end
end)

