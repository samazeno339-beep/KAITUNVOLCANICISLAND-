--========================================================

task.spawn(function()

	if not game:IsLoaded() then
		game.Loaded:Wait()
	end

	local Remotes =
		ReplicatedStorage:FindFirstChild("Remotes")

	if not Remotes then
		warn("HOÀI HUB: Remotes not found")
		return
	end

	local CommF_ =
		Remotes:FindFirstChild("CommF_")

	if not CommF_ then
		warn("HOÀI HUB: CommF_ not found")
		return
	end

	if LocalPlayer.Team then
		return
	end

	local Deadline =
		os.clock() + CONFIG.MarineTimeout

	while LocalPlayer.Parent
		and LocalPlayer.Team == nil
		and os.clock() < Deadline do

		pcall(function()

			CommF_:InvokeServer(
				"SetTeam",
				"Marines"
			)

		end)

		task.wait(0.5)
	end

	if LocalPlayer.Team then

		print(
			"HOÀI HUB: Team = "
			.. LocalPlayer.Team.Name
		)

	else

		warn(
			"HOÀI HUB: Auto Marine timeout"
		)

	end

end)

