local BeltInfo = {
	White  = {"White Belt", "đai Trắng"},
	Yellow = {"Yellow Belt", "đai Vàng"},
	Orange = {"Orange Belt", "đai Cam"},
	Green  = {"Green Belt", "đai Xanh Lá"},
	Blue   = {"Blue Belt", "đai Xanh Dương"},
	Purple = {"Purple Belt", "đai Tím"},
	Red    = {"Red Belt", "đai Đỏ"},
	Black  = {"Black Belt", "đai Đen"}
}

local function Status(Text)
	if _G.HoaiHubSetStatus then
		_G.HoaiHubSetStatus(Text)
	end
end

local function FindRemotes()
	local Remotes = ReplicatedStorage:FindFirstChild("Remotes")

	if not Remotes then
		return nil, nil, "Remotes folder not found"
	end

	local Dojo = Remotes:FindFirstChild("RF/InteractDragonQuest")

	local CommF = Remotes:FindFirstChild("CommF_")

	if not CommF then
		CommF = Remotes:FindFirstChild("CommF")
	end

	if DEBUG then
		print("[HOAI DATA] Dojo Remote:",
			Dojo and Dojo:GetFullName() or "NOT FOUND")

		print("[HOAI DATA] CommF:",
			CommF and CommF:GetFullName() or "NOT FOUND")
	end

	return Dojo, CommF, nil
end

local function ReadDojo(Remote)
	if not Remote then
		return nil, "Dojo Remote Not Found"
	end

	if not Remote:IsA("RemoteFunction") then
		return nil, "Dojo Remote Is Not RemoteFunction"
	end

	local OK, Result = pcall(function()
		return Remote:InvokeServer({
			NPC = "Dojo Trainer",
			Command = "RequestQuest"
		})
	end)

	if not OK then
		return nil, "Dojo Invoke Failed: " .. tostring(Result)
	end

	if DEBUG then
		print("[HOAI DATA] Dojo response type:",
			type(Result))

		if type(Result) == "table" then
			for K, V in pairs(Result) do
				print(
					"[HOAI DATA] Dojo:",
					tostring(K),
					tostring(V)
				)
			end
		end
	end

	if type(Result) ~= "table" then
		return nil, "Dojo Response Is Not Table"
	end

	if type(Result.BeltName) ~= "string" then
		return nil, "Dojo Response Has No BeltName"
	end

	return Result.BeltName, nil
end

local function ReadInventory(Remote)
	if not Remote then
		return nil, "Inventory Remote Not Found"
	end

	if not Remote:IsA("RemoteFunction") then
		return nil, "Inventory Remote Is Not RemoteFunction"
	end

	local OK, Result = pcall(function()
		return Remote:InvokeServer("getInventory")
	end)

	if not OK then
		return nil, "Inventory Invoke Failed: " .. tostring(Result)
	end

	if DEBUG then
		print("[HOAI DATA] Inventory response:",
			type(Result))
	end

	if type(Result) ~= "table" then
		return nil, "Inventory Response Is Not Table"
	end

	return Result, nil
end

local function ParseInventory(Inventory)
	local Found = {}

	for _, Entry in pairs(Inventory) do
		if type(Entry) == "table" then

			local Name =
				Entry.Name
				or Entry.ItemName
				or Entry.name
				or Entry.NameItem

			if type(Name) == "string" then
				Found[string.lower(Name)] = true

				if DEBUG then
					print(
						"[HOAI DATA] ITEM:",
						Name
					)
				end
			end

		elseif type(Entry) == "string" then

			Found[string.lower(Entry)] = true

			if DEBUG then
				print(
					"[HOAI DATA] ITEM:",
					Entry
				)
			end

		end
	end

	return Found
end

local function ReadProgress()

	local Result = {
		DataValid = false,
		Error = nil,

		HighestBeltRank = 0,

		Dragonstorm = false,
		Dragonheart = false
	}

	local DojoRemote, CommF, RemoteError =
		FindRemotes()

	if RemoteError then
		Result.Error = RemoteError
		return Result
	end

	local Belt, BeltError =
		ReadDojo(DojoRemote)

	if not Belt then
		Result.Error = BeltError
		return Result
	end

	local Rank = Belts[string.lower(Belt)]

	if not Rank then
		Result.Error =
			"Unknown Belt: " .. tostring(Belt)

		return Result
	end

	Result.HighestBeltRank = Rank

	local Inventory, InventoryError =
		ReadInventory(CommF)

	if not Inventory then
		Result.Error = InventoryError
		return Result
	end

	local Found =
		ParseInventory(Inventory)

	Result.Dragonstorm =
		Found["dragonstorm"] == true
		or Found["dragon storm"] == true

	Result.Dragonheart =
		Found["dragonheart"] == true
		or Found["dragon heart"] == true

	Result.DataValid = true

	return Result
end

local LastStatus = nil

local function SetProgressStatus(Text)
	if Text == LastStatus then
		return
	end

	LastStatus = Text
	Status(Text)
end

local function Update()
	local Data = ReadProgress()

	if not Data.DataValid then

		SetProgressStatus(
			"Data Read Failed / "
			.. tostring(Data.Error)
		)

		return
	end

	local Rank = Data.HighestBeltRank

	if Rank < 8 then

		for Name, Number in pairs(Belts) do

			if Number == Rank + 1 then

				SetProgressStatus(
					"Getting "
					.. BeltInfo[Name][1]
					.. " / Đang lấy "
					.. BeltInfo[Name][2]
					.. "..."
				)

				return
			end
		end

	elseif not Data.Dragonstorm then

		SetProgressStatus(
			"Getting Dragonstorm / Đang lấy Dragonstorm..."
		)

	elseif not Data.Dragonheart then

		SetProgressStatus(
			"Getting Dragonheart / Đang lấy Dragonheart..."
		)

	else

		SetProgressStatus(
			"Complete / Đã hoàn thành!"
		)
	end
end

task.spawn(function()

	while Player.Parent do

		local OK, Error =
			pcall(Update)

		if not OK then
			warn(
				"[HOAI DATA] ERROR:",
				Error
			)
		end

		task.wait(0.25)
	end

end)

_G.HoaiHubReadProgress = ReadProgress
_G.HoaiHubCheckProgress = Update

