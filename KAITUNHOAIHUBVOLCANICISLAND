local function SetProgress(name, completed)
	local data = ProgressRows[name]
	if not data then
		return
	end

	if completed then
		data.Status.Text = "●  COMPLETE"
		data.Status.TextColor3 = CFG.Success
		data.Bar.BackgroundColor3 = CFG.Success
	else
		data.Status.Text = "●  INCOMPLETE"
		data.Status.TextColor3 = CFG.Danger
		data.Bar.BackgroundColor3 = CFG.Danger
	end
end

local function SetStatus(text)
	StatusText.Text = "Status : " .. tostring(text)
end

