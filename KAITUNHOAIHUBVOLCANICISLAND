	-- Giữ nguyên nhân vật người chơi
	task.wait(0.2)

	for _, Object in ipairs(Character:GetDescendants()) do

		OptimizePart(Object)

		DisableEffect(Object)

	end

end)

-- NPC mới có Humanoid
Workspace.DescendantAdded:Connect(function(Object)

	if not Object:IsA("Model") then
		return
	end

	task.defer(function()

		task.wait(0.1)

		if Object.Parent
			and Object:FindFirstChildOfClass("Humanoid")
			and Object ~= LocalPlayer.Character then

			HideNPCClothes(Object)

		end

	end)

end)

