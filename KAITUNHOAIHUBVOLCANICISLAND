local function RunChecker()
    local account = Reader:GetAccount()
    local items = Reader:GetOwnedTools()

    local talonOwned, mastery = ReadDragonTalon()
    local dojoState, dojoExtra = Reader:GetDojo()
    local storm, heart = ReadInventoryFlags()

    -- Fallback to client-visible named evidence for the two items if inventory did not expose them.
    if storm == nil then
        storm = Reader:FindNamedEvidence("Dragon Storm")
    end
    if heart == nil then
        heart = Reader:FindNamedEvidence("Dragon Heart")
    end

    UpdateAccountUI(account)
    UpdateItemsUI(items)
    UpdateProgressUI(talonOwned, mastery, dojoState, dojoExtra, storm, heart)

    Cache.Account = account
    Cache.Items = table.concat(items, "\n")
    Cache.DragonTalonState = talonOwned
    Cache.DragonTalonMastery = mastery
    Cache.DojoState = dojoState
    Cache.DojoExtra = dojoExtra
    Cache.DragonStorm = storm
    Cache.DragonHeart = heart

    StatusText.Text = "Status : Last check " .. os.date("%H:%M:%S")
end

--========================================================--
-- STARTUP / LIVE LOOP
--========================================================--

SetRow("Dragon Talon", nil, "Mastery: --/500")
SetRow("Dojo Belt", nil, "--/8")
SetRow("Dragon Storm", nil, "--")
SetRow("Dragon Heart", nil, "--")

-- Immediate first check.
pcall(RunChecker)

-- One UI-oriented refresh every second.
task.spawn(function()
    while ScreenGui.Parent do
        task.wait(CFG.CheckInterval)
        pcall(RunChecker)
    end
end)

--========================================================--
-- FPS
--========================================================--

local frames = 0
local elapsed = 0

RunService.RenderStepped:Connect(function(dt)
    frames += 1
    elapsed += dt

    if elapsed >= 1 then
        BottomInfo.Text =
            "Ping: --    FPS: " .. tostring(frames)
            .. "    Players: " .. tostring(#Players:GetPlayers())
        frames = 0
        elapsed = 0
    end
end)

task.spawn(function()
    pcall(function()
        ContentProvider:PreloadAsync({Images, StatusImages, Floating})
    end)
end)

print("KaitunHoaiHub Pro Checker loaded.")
