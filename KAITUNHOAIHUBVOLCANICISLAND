--========================================================
-- MENU SHOW / HIDE
--========================================================

local MenuVisible = true

local function ShowMenu()

	MenuVisible = true
	Main.Visible = true

	Main.Size = UDim2.fromOffset(0, 0)

	local Tween = TweenService:Create(
		Main,
		TweenInfo.new(
			0.22,
			Enum.EasingStyle.Back,
			Enum.EasingDirection.Out
		),
		{
			Size = CONFIG.MenuSize
		}
	)

	Tween:Play()
end

local function HideMenu()

	MenuVisible = false

	local Tween = TweenService:Create(
		Main,
		TweenInfo.new(
			0.16,
			Enum.EasingStyle.Quad,
			Enum.EasingDirection.In
		),
		{
			Size = UDim2.fromOffset(0, 0)
		}
	)

	Tween:Play()

	Tween.Completed:Connect(function()

		if not MenuVisible then
			Main.Visible = false
		end

	end)
end

FloatButton.MouseButton1Click:Connect(function()

	if MenuVisible then
		HideMenu()
	else
		ShowMenu()
	end

end)

--========================================================
-- DRAG FLOATING LOGO
--========================================================

local Dragging = false
local DragStart
local StartPosition

FloatButton.InputBegan:Connect(function(Input)

	if Input.UserInputType == Enum.UserInputType.MouseButton1
		or Input.UserInputType == Enum.UserInputType.Touch then

		Dragging = true
		DragStart = Input.Position
		StartPosition = FloatButton.Position

		Input.Changed:Connect(function()

			if Input.UserInputState == Enum.UserInputState.End then
				Dragging = false
			end

		end)
	end

end)

UserInputService.InputChanged:Connect(function(Input)

	if not Dragging then
		return
	end

	if Input.UserInputType == Enum.UserInputType.MouseMovement
		or Input.UserInputType == Enum.UserInputType.Touch then

		local Delta = Input.Position - DragStart

		FloatButton.Position = UDim2.new(
			StartPosition.X.Scale,
			StartPosition.X.Offset + Delta.X,

			StartPosition.Y.Scale,
			StartPosition.Y.Offset + Delta.Y
		)
	end

end)

--========================================================
-- DISABLE VISUAL EFFECT
--========================================================

local function DisableEffect(Object)

	-- Particle / combat / environment effects
	if Object:IsA("ParticleEmitter")
		or Object:IsA("Trail")
		or Object:IsA("Beam")
		or Object:IsA("Fire")
		or Object:IsA("Smoke")
		or Object:IsA("Sparkles")
		or Object:IsA("Highlight") then

		pcall(function()
			Object.Enabled = false
		end)

		return
	end

	-- Post-processing
	if Object:IsA("BloomEffect")
		or Object:IsA("BlurEffect")
		or Object:IsA("ColorCorrectionEffect")
		or Object:IsA("DepthOfFieldEffect")
		or Object:IsA("SunRaysEffect") then

		pcall(function()
			Object.Enabled = false
		end)

	end
end

--========================================================
-- OPTIMIZE PART
--========================================================

local function OptimizePart(Object)

	if not Object:IsA("BasePart") then
		return
	end

	pcall(function()

		-- Cục nhựa
		Object.Material = Enum.Material.SmoothPlastic

		-- Tắt bóng
		Object.CastShadow = false

		-- Tắt phản chiếu
		Object.Reflectance = 0

	end)

	-- MeshPart
	if Object:IsA("MeshPart") then

		pcall(function()

			-- Ưu tiên performance
			Object.RenderFidelity = Enum.RenderFidelity.Performance

			-- Bỏ texture của MeshPart
			Object.TextureID = ""

		end)

	end
end

--========================================================
-- HIDE MAP DECAL / TEXTURE
--========================================================

local function HideMapTexture(Object)

	if Object:IsA("Texture")
		or Object:IsA("Decal") then

		pcall(function()
			Object.Transparency = 1
		end)

	end
end

--========================================================
-- HIDE NPC CLOTHES
--========================================================

local function HideNPCClothes(Character)

	if not Character:IsA("Model") then
		return
	end

	local Humanoid = Character:FindFirstChildOfClass("Humanoid")

	if not Humanoid then
		return
	end

	-- Không ẩn đồ của chính người chơi
	if Character == LocalPlayer.Character then
		return
	end

	for _, Object in ipairs(Character:GetDescendants()) do

		-- Accessory: tóc, mũ, áo phụ kiện, v.v.
		if Object:IsA("Accessory") then

			for _, Part in ipairs(Object:GetDescendants()) do

				if Part:IsA("BasePart") then

					pcall(function()

						Part.LocalTransparencyModifier = 1
						Part.CastShadow = false

					end)

				elseif Part:IsA("Texture")
					or Part:IsA("Decal") then

					pcall(function()
						Part.Transparency = 1
					end)

				end
			end

		-- Shirt
		elseif Object:IsA("Shirt") then

			pcall(function()
				Object.ShirtTemplate = ""
			end)

		-- Pants
		elseif Object:IsA("Pants") then

			pcall(function()
				Object.PantsTemplate = ""
			end)

		-- Shirt graphic
		elseif Object:IsA("ShirtGraphic") then

			pcall(function()
				Object.Graphic = ""
			end)

		-- Texture/Decal trên NPC
		elseif Object:IsA("Texture")
			or Object:IsA("Decal") then

			pcall(function()
				Object.Transparency = 1
			end)

		end
	end
end

--========================================================
-- PROCESS OBJECT
--========================================================

local function OptimizeObject(Object)

	-- Không đụng UI
	if Object:IsDescendantOf(PlayerGui) then
		return
	end

	DisableEffect(Object)

	OptimizePart(Object)

	HideMapTexture(Object)

end

