local function Normalize(Value)
	if typeof(Value) ~= "string" then
		return ""
	end

	Value = Value:gsub("^%s+", "")
	Value = Value:gsub("%s+$", "")
	Value = Value:gsub("%s+", " ")

	return string.lower(Value)
end

