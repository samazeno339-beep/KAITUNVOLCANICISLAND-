	BeltIndex[
		string.lower(Belt.Key)
	] = Index

end

--========================================================
-- NORMALIZE
--========================================================

local function Normalize(Name)

	if typeof(Name) ~= "string" then
		return ""
	end

	return string.lower(
		Name
			:gsub("^%s+", "")
			:gsub("%s+$", "")
			:gsub("%s+", " ")
	)

end

--========================================================
-- FIND DOJO REMOTE
--========================================================

local function FindDojoRemote()

	local Remotes =
		ReplicatedStorage:FindFirstChild("Remotes")

	if not Remotes then
		return nil
	end

	local Remote =
		Remotes:FindFirstChild(
			"RF/InteractDragonQuest"
		)

	if Remote
		and Remote:IsA("RemoteFunction") then

		return Remote
	end

	return nil
end

--========================================================
-- READ DOJO
--========================================================

local function ReadDojo()

	local Remote = FindDojoRemote()

	if not Remote then
		return nil
	end

	local Success, Result = pcall(function()

		return Remote:InvokeServer({
			NPC = "Dojo Trainer",
			Command = "RequestQuest"
		})

	end)

	if not Success then
		return nil
	end

	if type(Result) ~= "table" then
		return nil
	end

	return Result

end

--========================================================
-- CLIENT ITEM CHECK
--========================================================

local function BuildItems()

	local Owned = {}

	local function Scan(Container)

		if not Container then
			return
		end

		for _, Object in ipairs(
			Container:GetDescendants()
		) do

			local Name =
				Normalize(Object.Name)

			if Name ~= "" then
				Owned[Name] = true
			end

		end

	end

	Scan(Player.Character)

	Scan(
		Player:FindFirstChildOfClass(
			"Backpack"
		)
	)

	return Owned
end

local function HasItem(Owned, ...)

	for Index = 1, select("#", ...) do

		local Name =
			select(Index, ...)

		if Owned[
			Normalize(Name)
		] then

			return true
		end

	end

	return false
end

--========================================================
-- STATUS CACHE
--========================================================

local LastStatus = nil

local function ApplyStatus(Text)

	if LastStatus == Text then
		return
	end

	LastStatus = Text

	SetStatus(Text)

end

--========================================================
-- CHECK PROGRESS
--========================================================

local function CheckProgress()

	local Data = ReadDojo()

	if not Data then

		return
	end

	local CurrentBelt =
		Data.BeltName

	if type(CurrentBelt) ~= "string" then

		return
	end

	local CurrentIndex =
		BeltIndex[
			Normalize(CurrentBelt)
		]

	if not CurrentIndex then
		return
	end

	--====================================================
	-- NEXT BELT
	--====================================================

	if CurrentIndex < #Belts then

		local NextBelt =
			Belts[CurrentIndex + 1]

		ApplyStatus(
			"Getting "
			.. NextBelt.English
			.. " / Đang lấy "
			.. NextBelt.VN
			.. "..."
		)

		return
	end

	--====================================================
	-- BLACK -> DRAGONSTORM
	--====================================================

	local Owned = BuildItems()

	if not HasItem(
		Owned,
		"Dragonstorm",
		"Dragon Storm"
	) then

		ApplyStatus(
			"Getting Dragonstorm / Đang lấy Dragonstorm..."
		)

		return
	end

	--====================================================
	-- DRAGONHEART
	--====================================================

	if not HasItem(
		Owned,
		"Dragonheart",
		"Dragon Heart"
	) then

		ApplyStatus(
			"Getting Dragonheart / Đang lấy Dragonheart..."
		)

		return
	end

	--====================================================
	-- COMPLETE
	--====================================================

	ApplyStatus(
		"Complete / Đã hoàn thành!"
	)

end

