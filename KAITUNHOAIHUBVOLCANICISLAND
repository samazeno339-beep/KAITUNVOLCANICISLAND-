--==================================================
-- NORMALIZE
--==================================================

local function Normalize(Value)

    if typeof(Value) ~= "string" then
        return ""
    end

    local Text = Value:lower()

    Text = Text:gsub(
        "[%z\1-\31]",
        ""
    )

    Text = Text:gsub(
        "_",
        " "
    )

    Text = Text:gsub(
        "-",
        " "
    )

    Text = Text:gsub(
        "%s+",
        " "
    )

    return Text:match(
        "^%s*(.-)%s*$"
    ) or ""

end

--==================================================
-- ALIAS MATCH
--==================================================

local function MatchAlias(Text, Aliases)

    Text = Normalize(Text)

    if Text == "" then
        return false
    end

    for _, Alias in ipairs(Aliases) do

        if Text == Normalize(Alias) then
            return true
        end

    end

    return false
end

--==================================================
-- RECURSIVE INVENTORY SEARCH
--==================================================

local function SearchTable(
    Data,
    Aliases,
    Visited,
    Depth
)

    if Depth > 15 then
        return false
    end

    local DataType = typeof(Data)

    if DataType == "string" then

        return MatchAlias(
            Data,
            Aliases
        )

    end

    if DataType ~= "table" then
        return false
    end

    Visited = Visited or {}

    if Visited[Data] then
        return false
    end

    Visited[Data] = true

    -- Keys
    for Key, Value in pairs(Data) do

        if typeof(Key) == "string" then

            if MatchAlias(
                Key,
                Aliases
            ) then

                if Value ~= false
                    and Value ~= 0 then

                    return true
                end

            end

        end

    end

    -- Common fields + recursive
    for Key, Value in pairs(Data) do

        if typeof(Key) == "string" then

            local NormalizedKey = Normalize(Key)

            if NormalizedKey == "name"
                or NormalizedKey == "itemname"
                or NormalizedKey == "displayname"
                or NormalizedKey == "item"
                or NormalizedKey == "title"
                or NormalizedKey == "weapon" then

                if typeof(Value) == "string"
                    and MatchAlias(
                        Value,
                        Aliases
                    ) then

                    return true
                end

            end

        end

        if SearchTable(
            Value,
            Aliases,
            Visited,
            Depth + 1
        ) then

            return true
        end

    end

    return false
end

--==================================================
-- FIND INVENTORY REMOTE
--==================================================

local function FindInventoryRemote()

    local Remote = ReplicatedStorage:FindFirstChild(
        "GetInventory",
        true
    )

    if Remote
        and Remote:IsA("RemoteFunction") then

        return Remote, "direct"
    end

    local Remotes = ReplicatedStorage:FindFirstChild(
        "Remotes"
    )

    if Remotes then

        Remote = Remotes:FindFirstChild(
            "GetInventory",
            true
        )

        if Remote
            and Remote:IsA("RemoteFunction") then

            return Remote, "direct"
        end

    end

    Remote = ReplicatedStorage:FindFirstChild(
        "CommF_",
        true
    )

    if Remote
        and Remote:IsA("RemoteFunction") then

        return Remote, "commf"
    end

    return nil, nil
end

--==================================================
-- GET INVENTORY
--==================================================

local function GetInventory()

    local Remote, Mode = FindInventoryRemote()

    if not Remote then

        return nil,
            "GetInventory RemoteFunction not found"
    end

    if Mode == "direct" then

        local Success, Result = pcall(function()

            return Remote:InvokeServer()

        end)

        if Success
            and Result ~= nil then

            return Result, nil
        end

        local Success2, Result2 = pcall(function()

            return Remote:InvokeServer(
                "getInventory"
            )

        end)

        if Success2
            and Result2 ~= nil then

            return Result2, nil
        end

        return nil,
            "GetInventory InvokeServer failed"
    end

    if Mode == "commf" then

        local Success, Result = pcall(function()

            return Remote:InvokeServer(
                "getInventory"
            )

        end)

        if Success
            and Result ~= nil then

            return Result, nil
        end

        return nil,
            "CommF_ getInventory failed"
    end

    return nil, "Unknown RemoteFunction"
end

--==================================================
-- RESET
--==================================================

local function ResetResults()

    for _, Belt in ipairs(BELTS) do
        Progress.Belts[Belt.Key] = false
    end

    Progress.DojoCount = 0
    Progress.Dragonstorm = false
    Progress.Dragonheart = false
    Progress.TotalOwned = 0
end

--==================================================
-- SCAN
--==================================================

local function ScanInventory()

    if Progress.Reading then
        return false
    end

    Progress.Reading = true
    Progress.Error = nil

    local Inventory, ErrorMessage = GetInventory()

    if not Inventory then

        Progress.Ready = false

        Progress.Error =
            ErrorMessage
            or "Inventory unavailable"

        Progress.Reading = false

        return false
    end

    ResetResults()

    -- 8 BELTS
    for _, Belt in ipairs(BELTS) do

        local Owned = SearchTable(
            Inventory,
            Belt.Aliases,
            {},
            0
        )

        Progress.Belts[Belt.Key] = Owned

        if Owned then
            Progress.DojoCount += 1
            Progress.TotalOwned += 1
        end

    end

    -- DRAGONSTORM
    Progress.Dragonstorm = SearchTable(
        Inventory,
        SPECIAL_ITEMS.Dragonstorm,
        {},
        0
    )

    if Progress.Dragonstorm then
        Progress.TotalOwned += 1
    end

    -- DRAGONHEART
    Progress.Dragonheart = SearchTable(
        Inventory,
        SPECIAL_ITEMS.Dragonheart,
        {},
        0
    )

    if Progress.Dragonheart then
        Progress.TotalOwned += 1
    end

    Progress.Ready = true
    Progress.LastScan = os.clock()
    Progress.Reading = false

    return true
end

