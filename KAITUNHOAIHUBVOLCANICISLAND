local ReplicatedStorage = game:GetService("ReplicatedStorage")

local function FindRemote()
	local Remotes = ReplicatedStorage:FindFirstChild("Remotes")

	if not Remotes then
		return nil, "Remotes not found"
	end

	local Subclass = Remotes:FindFirstChild("Subclass")

	if not Subclass then
		return nil, "Subclass folder not found"
	end

	local GetPlayerData =
		Subclass:FindFirstChild("GetPlayerData")

	if not GetPlayerData then
		return nil, "Subclass.GetPlayerData not found"
	end

	if not GetPlayerData:IsA("RemoteFunction") then
		return nil, "GetPlayerData is not RemoteFunction"
	end

	return GetPlayerData, nil
end

local function ContainsTarget(Name)
	if typeof(Name) ~= "string" then
		return false
	end

	local N = string.lower(Name)

	local Targets = {
		"dojo belt (white)",
		"dojo belt (yellow)",
		"dojo belt (orange)",
		"dojo belt (green)",
		"dojo belt (blue)",
		"dojo belt (purple)",
		"dojo belt (red)",
		"dojo belt (black)",
		"dragonstorm",
		"dragon storm",
		"dragonheart",
		"dragon heart",
	}

	for _, Target in ipairs(Targets) do
		if N == Target then
			return true
		end
	end

	return false
end

local function ScanTable(Data, Path, Found)
	if type(Data) ~= "table" then
		return
	end

	for Key, Value in pairs(Data) do
		local CurrentPath =
			Path .. "." .. tostring(Key)

		if type(Value) == "table" then

			ScanTable(
				Value,
				CurrentPath,
				Found
			)

		elseif typeof(Value) == "string" then

			if ContainsTarget(Value) then
				Found[#Found + 1] = {
					Path = CurrentPath,
					Value = Value,
				}
			end

		end
	end
end

