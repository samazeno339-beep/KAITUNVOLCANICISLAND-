local function CreateValueBox(
	Parent,
	Text,
	DefaultValue,
	Callback
)

	local Holder = Instance.new("Frame")
	Holder.Size = UDim2.new(1, -4, 0, 38)
	Holder.BackgroundColor3 =
		Color3.fromRGB(39, 28, 46)
	Holder.BorderSizePixel = 0
	Holder.Parent = Parent

	local HolderCorner = Instance.new("UICorner")
	HolderCorner.CornerRadius = UDim.new(0, 8)
	HolderCorner.Parent = Holder

	local Label = Instance.new("TextLabel")
	Label.Size = UDim2.new(1, -105, 1, 0)
	Label.Position = UDim2.fromOffset(10, 0)
	Label.BackgroundTransparency = 1
	Label.Text = Text
	Label.TextColor3 =
		Color3.fromRGB(235, 220, 245)
	Label.TextSize = 13
	Label.Font = Enum.Font.Gotham
	Label.TextXAlignment =
		Enum.TextXAlignment.Left
	Label.Parent = Holder

	local Box = Instance.new("TextBox")
	Box.Size = UDim2.fromOffset(85, 28)
	Box.Position = UDim2.new(1, -92, 0.5, -14)
	Box.BackgroundColor3 =
		Color3.fromRGB(27, 20, 33)
	Box.BorderSizePixel = 0
	Box.Text = tostring(DefaultValue)
	Box.TextColor3 =
		Color3.fromRGB(220, 150, 255)
	Box.TextSize = 13
	Box.Font = Enum.Font.GothamBold
	Box.ClearTextOnFocus = false
	Box.Parent = Holder

	local BoxCorner = Instance.new("UICorner")
	BoxCorner.CornerRadius = UDim.new(0, 6)
	BoxCorner.Parent = Box

	local function Apply()

		local Number =
			tonumber(Box.Text)

		if Number then

			Number = math.clamp(
				Number,
				0,
				1000
			)

			Box.Text = tostring(Number)
			Callback(Number)

		else

			Box.Text = tostring(DefaultValue)
			Callback(DefaultValue)

		end
	end

	Box.FocusLost:Connect(Apply)

	return Box
end

