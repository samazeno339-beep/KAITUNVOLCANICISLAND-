-- TARGET CHECKS
--========================================================--

local function ScanProgress()
    local comm = FindCommF()

    local styles = SafeInvoke(comm, "getStyles")
    local gameData = SafeInvoke(comm, "getGameData")
    local inventory = SafeInvoke(comm, "getInventory")

    -- Dragon Talon
    local owned
    local mastery

    if type(styles) == "table" then
        for key, value in pairs(styles) do
            if type(value) == "table" then
                local name = value.Name or value.name or key

                if tostring(name):lower() == "dragon talon" then
                    local flag =
                        value.Owned or
                        value.owned or
                        value.IsUnlocked or
                        value.isUnlocked

                    if type(flag) == "boolean" then
                        owned = flag
                    end

                    mastery = ReadNumber(value, {"Mastery", "mastery"})
                end
            end
        end
    end

    SetProgress(
        "Dragon Talon",
        owned,
        "Mastery: " .. (mastery and (tostring(mastery) .. "/500") or "--/500")
    )

    -- Dojo Belt
    local dojo

    if type(gameData) == "table" then
        dojo = ReadNumber(
            gameData,
            {"DojoProgress", "DracoBeltProgress", "BeltProgress"}
        )
    end

    if dojo ~= nil and dojo >= 0 and dojo <= 8 then
        SetProgress("Dojo Belt", dojo >= 8, tostring(dojo) .. "/8")
    else
        SetProgress("Dojo Belt", nil, "--/8")
    end

    -- Dragon Storm / Dragon Heart
    local storm
    local heart

    if type(inventory) == "table" then
        for key, value in pairs(inventory) do
            local name

            if type(value) == "table" then
                name = value.Name or value.name
            end

            if not name and type(key) == "string" then
                name = key
            end

            if name then
                local low = tostring(name):lower()

                if low == "dragon storm" then
                    storm = true
                elseif low == "dragon heart" then
                    heart = true
                end
            end
        end
    end

    SetProgress("Dragon Storm", storm == true, storm and "FOUND" or "--")
    SetProgress("Dragon Heart", heart == true, heart and "FOUND" or "--")
end

--========================================================--
-- AUTO FLY TO UZOTH
--========================================================--

local AutoFly = {
    Flying = false,
    Target = nil,
    Connection = nil,
    NoClipConnection = nil,
    CollisionCache = {},
}

local FLY_SPEED = 30
local MIN_STOP_DISTANCE = 2
local INTERACTION_TIMEOUT = 8

local function GetCharacter()
    local character = Player.Character
    if not character then
        return nil
    end

    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local root = character:FindFirstChild("HumanoidRootPart")

    if not humanoid or not root then
        return nil
    end

    return character, humanoid, root
end

local function FindUzoth()
    local exact = workspace:FindFirstChild("UZOTH", true)

    if exact and (exact:IsA("Model") or exact:IsA("BasePart")) then
        return exact
    end

    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj.Name:lower() == "uzoth"
            and (obj:IsA("Model") or obj:IsA("BasePart")) then
            return obj
        end
    end

    return nil
end

local function GetTargetRoot(target)
    if not target then
        return nil
    end

    if target:IsA("BasePart") then
        return target
    end

    if target:IsA("Model") then
        return target:FindFirstChild("HumanoidRootPart")
            or target.PrimaryPart
            or target:FindFirstChildWhichIsA("BasePart")
    end

    return nil
end

local function FindPrompt(target)
    if not target then
        return nil
    end

    for _, obj in ipairs(target:GetDescendants()) do
        if obj:IsA("ProximityPrompt") and obj.Enabled then
            return obj
        end
    end

    return nil
end

local function StopAutoFly()
    AutoFly.Flying = false
    AutoFly.Target = nil

    if AutoFly.Connection then
        AutoFly.Connection:Disconnect()
        AutoFly.Connection = nil
    end

    if AutoFly.NoClipConnection then
        AutoFly.NoClipConnection:Disconnect()
        AutoFly.NoClipConnection = nil
    end

    for part, original in pairs(AutoFly.CollisionCache) do
        if part and part.Parent and part:IsA("BasePart") then
            part.CanCollide = original
        end
    end

    AutoFly.CollisionCache = {}

    local _, humanoid = GetCharacter()
    if humanoid then
        humanoid.AutoRotate = true
    end
end

local function EnableNoClip(character)
    AutoFly.CollisionCache = {}

    for _, obj in ipairs(character:GetDescendants()) do
        if obj:IsA("BasePart") then
            AutoFly.CollisionCache[obj] = obj.CanCollide
            obj.CanCollide = false
        end
    end

    AutoFly.NoClipConnection = character.DescendantAdded:Connect(function(obj)
        if AutoFly.Flying and obj:IsA("BasePart") then
            AutoFly.CollisionCache[obj] = obj.CanCollide
            obj.CanCollide = false
        end
    end)
end

local function FlyToUzoth()
    local target = FindUzoth()
    if not target then
        SetStatus("UZOTH not found")
        return false
    end

    local targetRoot = GetTargetRoot(target)
    if not targetRoot then
        SetStatus("UZOTH root not found")
        return false
    end

    local prompt = FindPrompt(target)
    local stopDistance = prompt
        and math.max(prompt.MaxActivationDistance - 1, MIN_STOP_DISTANCE)
        or 6

    local character, humanoid, root = GetCharacter()
    if not character or not humanoid or not root then
        SetStatus("Character not ready")
        return false
    end

    StopAutoFly()

    AutoFly.Flying = true
    AutoFly.Target = target

    humanoid.AutoRotate = false
    EnableNoClip(character)

    local startedAt = os.clock()

    AutoFly.Connection = RunService.Heartbeat:Connect(function()
        if not AutoFly.Flying then
            return
        end

        local _, currentHumanoid, currentRoot = GetCharacter()

        if not currentHumanoid or not currentRoot then
            StopAutoFly()
            return
        end

        targetRoot = GetTargetRoot(target)

        if not targetRoot or not targetRoot.Parent then
            StopAutoFly()
            SetStatus("UZOTH target lost")
            return
        end

        local offset = targetRoot.Position - currentRoot.Position
        local distance = offset.Magnitude

        if distance <= stopDistance then
            StopAutoFly()
            SetStatus("At UZOTH")
            return
        end

        local direction = offset.Unit

        currentRoot.AssemblyLinearVelocity = direction * FLY_SPEED
        currentRoot.CFrame = CFrame.lookAt(
            currentRoot.Position,
            targetRoot.Position
        )

        if os.clock() - startedAt >= INTERACTION_TIMEOUT then
            StopAutoFly()
            SetStatus("Fly timeout")
        end
    end)

    return true
end

_G.KaitunAutoFlyUzoth = {
    FlyToUzoth = FlyToUzoth,
    StopFly = StopAutoFly,
    FindUzoth = FindUzoth,
    IsFlying = function()
        return AutoFly.Flying
    end,
}

