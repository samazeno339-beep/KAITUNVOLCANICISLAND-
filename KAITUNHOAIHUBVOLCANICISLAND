--========================================================
-- AUTO MARINES
--========================================================

task.spawn(function()

	if not game:IsLoaded() then
		game.Loaded:Wait()
	end

	if Player.Team then
		return
	end

	local Remotes =
		ReplicatedStorage:FindFirstChild("Remotes")

	if not Remotes then
		warn("HOÀI HUB: Remotes not found")
		return
	end

	local CommF_ =
		Remotes:FindFirstChild("CommF_")

	if not CommF_ then
		warn("HOÀI HUB: CommF_ not found")
		return
	end

	for _ = 1, 20 do

		if Player.Team then
			break
		end

		pcall(function()
			CommF_:InvokeServer(
				"SetTeam",
				CONFIG.Team
			)
		end)

		task.wait(0.5)
	end

end)

