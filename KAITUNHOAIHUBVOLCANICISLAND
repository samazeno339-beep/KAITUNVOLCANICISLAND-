end

--==================================================
-- CHECK LOOP
--
-- THIS IS THE IMPORTANT PART:
-- Scan every 1 second, then automatically update
-- the EXTERNAL Status panel.
--==================================================

task.spawn(function()

    while ScreenGui
        and ScreenGui.Parent do

        local Success = pcall(function()

            ScanInventory()

            -- Automatically show/update Status
            -- after every scan.
            _G.HoaiHub.SetStatus(
                GetCheckStatus()
            )

        end)

        if not Success then

            pcall(function()

                _G.HoaiHub.SetStatus(
                    "Checker error - retrying..."
                )

            end)
        end

        task.wait(
            CONFIG.CheckInterval
        )
    end
end)

--==================================================
-- AUTO SELECT MARINES
--==================================================

task.spawn(function()

    if not CONFIG.AutoSelectMarines then
        return
    end

    if not game:IsLoaded() then
        game.Loaded:Wait()
    end

    -- Already has a team.
    if Player.Team then

        print(
            "HOAIHUB: Team already selected -> " ..
            Player.Team.Name
        )

        return
    end

    local Remotes = ReplicatedStorage:WaitForChild(
        "Remotes",
        30
    )

    if not Remotes then

        warn(
            "HOAIHUB: Remotes not found"
        )

        return
    end

    local CommF_ = Remotes:WaitForChild(
        "CommF_",
        30
    )

    if not CommF_ then

        warn(
            "HOAIHUB: CommF_ not found"
        )

        return
    end

    local Deadline =
        os.clock() +
        CONFIG.MarineTimeout

    while Player.Parent
        and Player.Team == nil
        and os.clock() < Deadline do

        local Success, Result = pcall(function()

            return CommF_:InvokeServer(
                "SetTeam",
                "Marines"
            )
        end)

        if Success then

            print(
                "HOAIHUB: SetTeam -> Marines",
                Result
            )

        else

            warn(
                "HOAIHUB: SetTeam failed:",
                Result
            )
        end

        task.wait(
            CONFIG.MarineRetryInterval
        )
    end

    if Player.Team then

        print(
            "HOAIHUB: Current Team = " ..
            Player.Team.Name
        )

    else

        warn(
            "HOAIHUB: Marine selection failed"
        )
    end
end)

