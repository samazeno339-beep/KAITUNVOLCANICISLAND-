task.spawn(function()

	while Player.Parent do

		local Success, Progress =
			pcall(ReadBloxFruitsProgress)

		if not Success then

			if LastError ~= "Reader Exception" then
				LastError = "Reader Exception"

				SetStatus(
					"Data Read Failed / Không đọc được dữ liệu"
				)

				warn(
					"[HOAI DATA] Reader exception:",
					Progress
				)
			end

		else

			LastError = nil

			local Objective =
				GetNextObjective(Progress)

			if Objective ~= LastObjective then

				LastObjective = Objective

				SetStatus(Objective)

				if CONFIG.DEBUG then
					print(
						"[HOAI DATA]",
						Objective
					)
				end
			end
		end

		task.wait(CONFIG.CHECK_INTERVAL)
	end

end)

