--========================================================
-- NORMALIZE
--========================================================

local function Normalize(Text)

	if typeof(Text) ~= "string" then
		return ""
	end

	Text = Text:gsub("^%s+", "")
	Text = Text:gsub("%s+$", "")
	Text = Text:gsub("%s+", " ")

	return string.lower(Text)
end

--========================================================
-- REBUILD BELT INDEX
--========================================================

BeltIndex = {}

for Index, Belt in ipairs(Belts) do
	BeltIndex[Normalize(Belt.Key)] = Index
end

--========================================================
-- FIND DOJO REMOTE
--========================================================

local function FindDojoRemote()

	local Remotes =
		ReplicatedStorage:FindFirstChild("Remotes")

	if not Remotes then
		return nil
	end

	local Remote =
		Remotes:FindFirstChild(
			"RF/InteractDragonQuest"
		)

	if Remote
		and Remote:IsA("RemoteFunction") then

		return Remote
	end

	return nil
end

--========================================================
-- READ DOJO
--========================================================

local function ReadDojoBelt()

	local Remote =
		FindDojoRemote()

	if not Remote then
		return nil
	end

	local Success, Result =
		pcall(function()

			return Remote:InvokeServer({
				NPC = "Dojo Trainer",
				Command = "RequestQuest"
			})

		end)

	if not Success then
		return nil
	end

	if type(Result) ~= "table" then
		return nil
	end

	if type(Result.BeltName) ~= "string" then
		return nil
	end

	return Result.BeltName
end

--========================================================
-- READ VISIBLE ITEMS
--========================================================

local function BuildOwnedItems()

	local Owned = {}

	local function Scan(Container)

		if not Container then
			return
		end

		for _, Object in ipairs(
			Container:GetDescendants()
		) do

			local Name =
				Normalize(Object.Name)

			if Name ~= "" then
				Owned[Name] = true
			end

		end
	end

	Scan(Player.Character)

	Scan(
		Player:FindFirstChildOfClass(
			"Backpack"
		)
	)

	return Owned
end

local function HasItem(Owned, ...)

	for Index = 1, select("#", ...) do

		local Name =
			select(Index, ...)

		if Owned[Normalize(Name)] then
			return true
		end

	end

	return false
end

--========================================================
-- READ ALL PROGRESS
--========================================================

local function ReadBloxFruitsProgress()

	local Result = {
		CurrentBelt = nil,
		HighestBeltRank = 0,
		Belts = {},
		DragonStorm = false,
		DragonHeart = false
	}

	--====================================================
	-- DOJO
	--====================================================

	local CurrentBelt =
		ReadDojoBelt()

	Result.CurrentBelt =
		CurrentBelt

	if type(CurrentBelt) == "string" then

		local CurrentIndex =
			BeltIndex[Normalize(CurrentBelt)]

		if CurrentIndex then

			Result.HighestBeltRank =
				CurrentIndex

			for Index, Belt in ipairs(
				Belts
			) do

				Result.Belts[
					Belt.ItemName
				] =
					Index <= CurrentIndex

			end
		end
	end

	--====================================================
	-- DRAGON ITEMS
	--====================================================

	local Owned =
		BuildOwnedItems()

	Result.DragonStorm =
		HasItem(
			Owned,
			"Dragonstorm",
			"Dragon Storm"
		)

	Result.DragonHeart =
		HasItem(
			Owned,
			"Dragonheart",
			"Dragon Heart"
		)

	return Result
end

