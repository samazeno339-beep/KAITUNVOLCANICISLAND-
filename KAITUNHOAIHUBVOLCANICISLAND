--========================================================--
-- ACCOUNT INVENTORY
-- Hiển thị inventory tài khoản, không lấy món đang cầm làm
-- toàn bộ inventory.
--========================================================--

local function GetAccountInventory()
    local comm = FindCommF()
    if not comm then
        return nil
    end

    -- Chỉ coi kết quả là inventory khi server thực sự trả table.
    local commands = {
        "getInventory",
        "GetInventory",
        "Inventory",
    }

    for _, command in ipairs(commands) do
        local result = SafeInvoke(comm, command)

        if type(result) == "table" then
            return result
        end
    end

    return nil
end

local function ParseAccountInventory(data)
    if type(data) ~= "table" then
        return nil
    end

    local items = {}
    local seen = {}

    local function add(name)
        if type(name) ~= "string" or name == "" then
            return
        end

        local key = name:lower()

        if not seen[key] then
            seen[key] = true
            table.insert(items, name)
        end
    end

    local function scan(tbl, parentKey)
        if type(tbl) ~= "table" then
            return
        end

        -- Common item shapes.
        local itemName =
            tbl.Name or
            tbl.name or
            tbl.ItemName or
            tbl.itemName or
            tbl.DisplayName or
            tbl.displayName

        if type(itemName) == "string" then
            add(itemName)
        end

        -- Map-style inventories:
        -- ["Saber"] = true
        -- ["Bisento"] = 1
        for key, value in pairs(tbl) do
            if type(key) == "string" then
                if type(value) == "boolean" and value then
                    add(key)
                elseif type(value) == "number" and value > 0 then
                    add(key)
                elseif type(value) == "table" then
                    scan(value, key)
                end
            elseif type(value) == "table" then
                scan(value, parentKey)
            end
        end
    end

    scan(data, "inventory")

    table.sort(items, function(a, b)
        return a:lower() < b:lower()
    end)

    return items
end

local function ScanInventory()
    local inventory = GetAccountInventory()
    local items = ParseAccountInventory(inventory)

    if items == nil then
        WeaponsText.Text =
            "Inventory: NOT READ\n" ..
            "Account inventory data is not exposed."
        return
    end

    if #items == 0 then
        WeaponsText.Text =
            "Inventory: READ (0)\n" ..
            "No inventory items returned."
        return
    end

    WeaponsText.Text =
        "Inventory: READ (" .. tostring(#items) .. ")\n" ..
        table.concat(items, "\n")
end

