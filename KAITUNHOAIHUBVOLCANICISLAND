local dragging = false
local dragStart = Vector2.zero
local startPos = Main.Position

Header.InputBegan:Connect(function(input)
    if not ClickInput(input) then return end
    dragging = true
    dragStart = input.Position
    startPos = Main.Position
end)

UserInputService.InputChanged:Connect(function(input)
    if not dragging then return end
    if input.UserInputType ~= Enum.UserInputType.MouseMovement
        and input.UserInputType ~= Enum.UserInputType.Touch then
        return
    end

    local delta = input.Position - dragStart
    Main.Position = UDim2.new(
        startPos.X.Scale, startPos.X.Offset + delta.X,
        startPos.Y.Scale, startPos.Y.Offset + delta.Y
    )
end)

UserInputService.InputEnded:Connect(function(input)
    if ClickInput(input) then dragging = false end
end)

--========================================================--
-- DATA READER
--========================================================--

local Reader = {}

local function GetContainers()
    return {
        Player,
        Player.Character,
        Player:FindFirstChildOfClass("Backpack"),
        Player:FindFirstChild("Data"),
        Player:FindFirstChild("leaderstats"),
    }
end

function Reader:GetValue(names)
    for _, container in ipairs(GetContainers()) do
        if container then
            for _, wanted in ipairs(names) do
                local obj = container:FindFirstChild(wanted, true)

                if obj and obj:IsA("ValueBase") then
                    local ok, value = pcall(function() return obj.Value end)
                    if ok then return value end
                end
            end
        end
    end

    for _, wanted in ipairs(names) do
        local value = Player:GetAttribute(wanted)
        if value ~= nil then return value end
    end

    return nil
end

function Reader:GetAccount()
    return {
        Name = Player.Name,
        Level = self:GetValue({"Level", "Lv", "LevelData"}),
        Beli = self:GetValue({"Beli", "Money", "BeliCount"}),
        Fragments = self:GetValue({"Fragments", "Fragment"}),
    }
end

function Reader:GetOwnedTools()
    local list, seen = {}, {}

    local function add(name)
        local key = Normalize(name)
        if key == "" or seen[key] then return end
        seen[key] = true
        table.insert(list, tostring(name))
    end

    for _, container in ipairs(GetContainers()) do
        if container then
            for _, obj in ipairs(container:GetChildren()) do
                if obj:IsA("Tool") then add(obj.Name) end
            end
        end
    end

    table.sort(list, function(a, b) return Normalize(a) < Normalize(b) end)
    return list
end

function Reader:FindNamedEvidence(targetName)
    local target = Normalize(targetName)
    local found = false

    for _, container in ipairs(GetContainers()) do
        if container then
            for _, obj in ipairs(container:GetDescendants()) do
                if Normalize(obj.Name) == target then
                    found = true
                    if obj:IsA("Tool") then
                        return true, "Tool"
                    end
                end

                if obj:IsA("BoolValue") and Normalize(obj.Name) == target then
                    return obj.Value, "BoolValue"
                end
            end
        end
    end

    for attrName, attrValue in pairs(Player:GetAttributes()) do
        if Normalize(attrName) == target then
            local state = ToBoolean(attrValue)
            if state ~= nil then
                return state, "Attribute"
            end
        end
    end

    if found then
        return true, "Object"
    end

    return nil, nil
end

function Reader:GetDojo()
    local exactProgress = ToNumber(self:GetValue({
        "DojoProgress", "DracoBeltProgress", "BeltProgress"
    }))

    if exactProgress ~= nil and exactProgress >= 0 and exactProgress <= 8 then
        exactProgress = math.floor(exactProgress)
        return exactProgress >= 8, tostring(exactProgress) .. "/8"
    end

    local count, known = 0, false
    for _, belt in ipairs(DOJO_BELTS) do
        local state = self:FindNamedEvidence(belt)
        if state ~= nil then known = true end
        if state == true then count += 1 end
    end

    if count == 8 then
        return true, "8/8"
    end
    if known then
        return false, tostring(count) .. "/8"
    end

    return nil, "--/8"
end

-- Optional remote adapter. All calls are protected and can fail harmlessly.
local function FindCommF()
    local remotes = ReplicatedStorage:FindFirstChild("Remotes")
    local commF = remotes and remotes:FindFirstChild("CommF_")
    if commF and commF:IsA("RemoteFunction") then
        return commF
    end
    return nil
end

local function SafeInvoke(remote, command)
    if not remote then return nil end

    local ok, result = pcall(function()
        return remote:InvokeServer(command)
    end)

    return ok and result or nil
end

local function FindStyleData(root, wantedName)
    if type(root) ~= "table" then return nil end

    local wanted = Normalize(wantedName)

    for key, value in pairs(root) do
        local candidate

        if type(value) == "table" then
            candidate = value.Name or value.name or value.StyleName or value.styleName
        end

        if candidate == nil and type(key) == "string" then
            candidate = key
        end

        if candidate and Normalize(candidate) == wanted then
            return value
        end
    end

    for _, value in pairs(root) do
        if type(value) == "table" then
            local nested = FindStyleData(value, wantedName)
            if nested ~= nil then return nested end
        end
    end

    return nil
end

local function ReadDragonTalon()
    local remote = FindCommF()
    local styles = SafeInvoke(remote, "getStyles")

    if type(styles) ~= "table" then
        return Reader:FindNamedEvidence("Dragon Talon"), nil
    end

    local data = FindStyleData(styles, "Dragon Talon")
    if type(data) ~= "table" then
        return nil, nil
    end

    local owned = ToBoolean(data.Owned)
        or ToBoolean(data.owned)
        or ToBoolean(data.IsUnlocked)
        or ToBoolean(data.isUnlocked)

    local mastery = ToNumber(data.Mastery)
        or ToNumber(data.mastery)

    return owned, mastery
end

local function ReadInventoryFlags()
    local remote = FindCommF()
    local inventory = SafeInvoke(remote, "getInventory")

    if type(inventory) ~= "table" then
        return nil, nil
    end

    local storm, heart = nil, nil

    for key, value in pairs(inventory) do
        local name
        local owned

        if type(value) == "table" then
            name = value.Name or value.name or value.ItemName or value.itemName
            owned = ToBoolean(value.Owned or value.owned or value.IsOwned or value.isOwned)
        elseif type(value) == "string" then
            name = value
        elseif type(key) == "string" then
            name = key
        end

        if name then
            local low = Normalize(name)
            if low == "dragon storm" then
                storm = owned == false and false or true
            elseif low == "dragon heart" then
                heart = owned == false and false or true
            end
        end
    end

    return storm, heart
end

