	ReplicatedStorage:GetDescendants()
) do

	if Object:IsA("RemoteFunction")
		or Object:IsA("RemoteEvent") then

		local FullName =
			string.lower(Object:GetFullName())

		local ObjectName =
			string.lower(Object.Name)

		local Keywords = {
			"inventory",
			"item",
			"weapon",
			"accessory",
			"stash",
			"storage",
			"backpack",
			"craft",
			"data",
			"playerdata"
		}

		for _, Keyword in ipairs(Keywords) do

			if string.find(
				FullName,
				Keyword,
				1,
				true
			)
			or string.find(
				ObjectName,
				Keyword,
				1,
				true
			) then

				RemoteFound = true

				print(
					"[REMOTE]",
					Object.ClassName,
					"|",
					Object:GetFullName()
				)

				break
			end
		end
	end
end

