--==================================================
-- OVERALL STATUS
--==================================================

local function GetCheckStatus()

    if not Progress.Ready then

        if Progress.Error then
            return "Inventory Error: " ..
                tostring(Progress.Error)
        end

        return "Reading Inventory..."
    end

    if Progress.DojoCount < 8 then
        return GetDojoStatus()
    end

    if not Progress.Dragonstorm then
        return "Dojo Complete ✓  →  Getting Dragonstorm..."
    end

    if not Progress.Dragonheart then
        return "Dragonstorm ✓  →  Getting Dragonheart..."
    end

    return "HOAIHUB Complete ✓"
end

