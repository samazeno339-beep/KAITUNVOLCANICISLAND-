--========================================================
-- CHECK ITEM
--========================================================

local function HasItem(ItemName)

	local Backpack = Player:FindFirstChildOfClass("Backpack")

	if Backpack and Backpack:FindFirstChild(ItemName, true) then
		return true
	end

	local Character = Player.Character

	if Character and Character:FindFirstChild(ItemName, true) then
		return true
	end

	return false
end

--========================================================
-- DRAGON ITEMS
--========================================================

local function HasDragonStorm()

	return
		HasItem("Dragon Storm")
		or HasItem("Dragonstorm")
end

local function HasDragonHeart()

	return
		HasItem("Dragonheart")
		or HasItem("Dragon Heart")
		or HasItem("DragonHeart")
end

