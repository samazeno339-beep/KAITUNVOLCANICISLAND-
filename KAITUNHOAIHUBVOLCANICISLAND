	Lighting.EnvironmentSpecularScale = 0
	Lighting.FogEnd = 100000
end)

--------------------------------------------------
-- XÓA POST PROCESSING
--------------------------------------------------

local function RemovePostEffect(obj)
	if obj:IsA("BloomEffect")
		or obj:IsA("BlurEffect")
		or obj:IsA("ColorCorrectionEffect")
		or obj:IsA("DepthOfFieldEffect")
		or obj:IsA("SunRaysEffect") then

		pcall(function()
			obj:Destroy()
		end)
	end
end

for _, obj in ipairs(Lighting:GetChildren()) do
	RemovePostEffect(obj)
end

Lighting.ChildAdded:Connect(function(obj)
	task.defer(function()
		if obj.Parent then
			RemovePostEffect(obj)
		end
	end)
end)

--------------------------------------------------
-- EFFECTS
--------------------------------------------------

local function RemoveEffect(obj)

	if obj:IsA("ParticleEmitter")
		or obj:IsA("Trail")
		or obj:IsA("Beam")
		or obj:IsA("Fire")
		or obj:IsA("Smoke")
		or obj:IsA("Sparkles")
		or obj:IsA("Highlight") then

		pcall(function()
			obj:Destroy()
		end)

	end

end

--------------------------------------------------
-- TỐI ƯU ĐỒ HỌA
--------------------------------------------------

local function Optimize(obj)

	-- Tất cả Part / MeshPart thành kiểu xi măng đơn giản
	if obj:IsA("BasePart") then

		pcall(function()
			obj.Material = Enum.Material.Concrete
			obj.CastShadow = false
			obj.Reflectance = 0
		end)

	end

	-- Ẩn texture/decal
	if obj:IsA("Texture") or obj:IsA("Decal") then

		pcall(function()
			obj.Transparency = 1
		end)

	end

	-- Xóa effect
	RemoveEffect(obj)

end

--------------------------------------------------
-- ÁP DỤNG TOÀN MAP
--------------------------------------------------

for _, obj in ipairs(Workspace:GetDescendants()) do
	Optimize(obj)
end

--------------------------------------------------
-- OBJECT MỚI
--------------------------------------------------

Workspace.DescendantAdded:Connect(function(obj)

	task.defer(function()

		if obj.Parent then
			Optimize(obj)
		end

	end)

end)

--------------------------------------------------
-- CHARACTER
--------------------------------------------------

LocalPlayer.CharacterAdded:Connect(function(character)

	task.wait(0.2)

	for _, obj in ipairs(character:GetDescendants()) do

		if obj:IsA("BasePart") then

			pcall(function()
				obj.Material = Enum.Material.Concrete
				obj.CastShadow = false
				obj.Reflectance = 0
			end)

		elseif obj:IsA("ParticleEmitter")
			or obj:IsA("Trail")
			or obj:IsA("Beam")
			or obj:IsA("Fire")
			or obj:IsA("Smoke")
			or obj:IsA("Sparkles")
			or obj:IsA("Highlight") then

			pcall(function()
				obj:Destroy()
			end)

		end

	end

end)

