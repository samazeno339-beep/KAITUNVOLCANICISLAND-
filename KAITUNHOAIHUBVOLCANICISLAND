--==================================================
-- NORMALIZE
--==================================================

local function Normalize(Value)

    if typeof(Value) ~= "string" then
        return ""
    end

    local Text = Value:lower()

    Text = Text:gsub(
        "[%z\1-\31]",
        ""
    )

    Text = Text:gsub(
        "_",
        " "
    )

    Text = Text:gsub(
        "-",
        " "
    )

    Text = Text:gsub(
        "%s+",
        " "
    )

    return Text:match(
        "^%s*(.-)%s*$"
    ) or ""
end

local function MatchAlias(Text, Aliases)

    Text = Normalize(Text)

    if Text == "" then
        return false
    end

    for _, Alias in ipairs(Aliases) do

        if Text == Normalize(Alias) then
            return true
        end

    end

    return false
end

--==================================================
-- RECURSIVE INVENTORY SEARCH
--==================================================

local function SearchTable(
    Data,
    Aliases,
    Visited,
    Depth
)

    if Depth > 15 then
        return false
    end

    local DataType = typeof(Data)

    if DataType == "string" then
        return MatchAlias(
            Data,
            Aliases
        )
    end

    if DataType ~= "table" then
        return false
    end

    Visited = Visited or {}

    if Visited[Data] then
        return false
    end

    Visited[Data] = true

    -- Check keys.
    for Key, Value in pairs(Data) do

        if typeof(Key) == "string"
            and MatchAlias(
                Key,
                Aliases
            )
            and Value ~= false
            and Value ~= 0 then

            return true
        end
    end

    -- Check common name fields + nested tables.
    for Key, Value in pairs(Data) do

        if typeof(Key) == "string" then

            local K = Normalize(Key)

            if K == "name"
                or K == "itemname"
                or K == "displayname"
                or K == "item"
                or K == "title"
                or K == "weapon" then

                if typeof(Value) == "string"
                    and MatchAlias(
                        Value,
                        Aliases
                    ) then

                    return true
                end
            end
        end

        if SearchTable(
            Value,
            Aliases,
            Visited,
            Depth + 1
        ) then

            return true
        end
    end

    return false
end

--==================================================
-- FIND GETINVENTORY REMOTE
--==================================================

local function FindInventoryRemote()

    -- Preferred: an actual RemoteFunction named GetInventory.
    local Remote = ReplicatedStorage:FindFirstChild(
        "GetInventory",
        true
    )

    if Remote
        and Remote:IsA("RemoteFunction") then

        return Remote, "direct"
    end

    -- Search under Remotes.
    local Remotes = ReplicatedStorage:FindFirstChild(
        "Remotes"
    )

    if Remotes then

        Remote = Remotes:FindFirstChild(
            "GetInventory",
            true
        )

        if Remote
            and Remote:IsA("RemoteFunction") then

            return Remote, "direct"
        end
    end

    -- Blox Fruits-style fallback.
    Remote = ReplicatedStorage:FindFirstChild(
        "CommF_",
        true
    )

    if Remote
        and Remote:IsA("RemoteFunction") then

        return Remote, "commf"
    end

    return nil, nil
end

--==================================================
-- GET INVENTORY
--==================================================

local function GetInventory()

    local Remote, Mode = FindInventoryRemote()

    if not Remote then

        return nil,
            "GetInventory RemoteFunction not found"
    end

    if Mode == "direct" then

        local Success, Result = pcall(function()
            return Remote:InvokeServer()
        end)

        if Success
            and Result ~= nil then

            return Result, nil
        end

        -- Some implementations expose a command.
        local Success2, Result2 = pcall(function()
            return Remote:InvokeServer(
                "getInventory"
            )
        end)

        if Success2
            and Result2 ~= nil then

            return Result2, nil
        end

        return nil,
            "GetInventory InvokeServer failed"
    end

    if Mode == "commf" then

        local Success, Result = pcall(function()

            return Remote:InvokeServer(
                "getInventory"
            )

        end)

        if Success
            and Result ~= nil then

            return Result, nil
        end

        return nil,
            "CommF_ getInventory failed"
    end

    return nil, "Unknown RemoteFunction"
end

--==================================================
-- RESET RESULTS
--==================================================

local function ResetResults()

    for _, Belt in ipairs(BELTS) do
        Progress.Belts[Belt.Key] = false
    end

    Progress.DojoCount = 0
    Progress.Dragonstorm = false
    Progress.Dragonheart = false
    Progress.TotalOwned = 0
end

--==================================================
-- SCAN INVENTORY
--==================================================

local function ScanInventory()

    if Progress.Reading then
        return false
    end

    Progress.Reading = true
    Progress.Error = nil

    local Inventory, ErrorMessage = GetInventory()

    if not Inventory then

        Progress.Ready = false
        Progress.Error =
            ErrorMessage
            or "Inventory unavailable"

        Progress.Reading = false

        return false
    end

    ResetResults()

    -- 8 belts.
    for _, Belt in ipairs(BELTS) do

        local Owned = SearchTable(
            Inventory,
            Belt.Aliases,
            {},
            0
        )

        Progress.Belts[Belt.Key] = Owned

        if Owned then
            Progress.DojoCount += 1
            Progress.TotalOwned += 1
        end
    end

    -- Dragonstorm.
    Progress.Dragonstorm = SearchTable(
        Inventory,
        SPECIAL_ITEMS.Dragonstorm,
        {},
        0
    )

    if Progress.Dragonstorm then
        Progress.TotalOwned += 1
    end

    -- Dragonheart.
    Progress.Dragonheart = SearchTable(
        Inventory,
        SPECIAL_ITEMS.Dragonheart,
        {},
        0
    )

    if Progress.Dragonheart then
        Progress.TotalOwned += 1
    end

    Progress.Ready = true
    Progress.LastScan = os.clock()
    Progress.Reading = false

    return true
end

--==================================================
-- DOJO STATUS
--==================================================

local function GetDojoStatus()

    if not Progress.Belts.White then
        return "Getting White Belt..."
    end

    if not Progress.Belts.Yellow then
        return "White Belt ✓  →  Getting Yellow Belt..."
    end

    if not Progress.Belts.Orange then
        return "Yellow Belt ✓  →  Getting Orange Belt..."
    end

    if not Progress.Belts.Green then
        return "Orange Belt ✓  →  Getting Green Belt..."
    end

    if not Progress.Belts.Blue then
        return "Green Belt ✓  →  Getting Blue Belt..."
    end

    if not Progress.Belts.Purple then
        return "Blue Belt ✓  →  Getting Purple Belt..."
    end

    if not Progress.Belts.Red then
        return "Purple Belt ✓  →  Getting Red Belt..."
    end

    if not Progress.Belts.Black then
        return "Red Belt ✓  →  Getting Black Belt..."
    end

    return "Black Belt ✓  →  Dojo Complete"
end

--==================================================
-- OVERALL STATUS
--==================================================

local function GetCheckStatus()

    if not Progress.Ready then

        if Progress.Error then
            return "Inventory Error: " ..
                tostring(Progress.Error)
        end

        return "Reading Inventory..."
    end

    if Progress.DojoCount < 8 then
        return GetDojoStatus()
    end

    if not Progress.Dragonstorm then
        return "Dojo Complete ✓  →  Getting Dragonstorm..."
    end

    if not Progress.Dragonheart then
        return "Dragonstorm ✓  →  Getting Dragonheart..."
    end

    return "HOAIHUB Complete ✓"
end

--==================================================
-- PUBLIC CHECKER API
--==================================================

_G.HoaiHubChecker = {

    Scan = function()
        return ScanInventory()
    end,

    GetProgress = function()
        return Progress
    end,

    GetStatus = function()
        return GetCheckStatus()
    end,

    GetDojoStatus = function()
        return GetDojoStatus()
    end,

    HasBelt = function(Name)

        if typeof(Name) ~= "string" then
            return false
        end

        Name = Name:gsub(
            "%s+",
            ""
        )

        return Progress.Belts[Name] == true
    end,

    HasDragonstorm = function()
        return Progress.Dragonstorm == true
    end,

    HasDragonheart = function()
        return Progress.Dragonheart == true
    end,

    IsDojoComplete = function()
        return Progress.DojoCount == 8
    end,

    IsComplete = function()

        return
            Progress.DojoCount == 8
            and Progress.Dragonstorm == true
            and Progress.Dragonheart == true
    end
}

