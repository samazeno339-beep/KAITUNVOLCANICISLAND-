--========================================================--
-- MAIN DRAG
--========================================================--

local draggingMain = false
local dragStart = Vector2.zero
local startPosition = Main.Position
local targetPosition = Main.Position

local function startMainDrag(input)
	if not InputIsClick(input) then
		return
	end

	draggingMain = true
	dragStart = input.Position
	startPosition = Main.Position
	targetPosition = Main.Position
end

Header.InputBegan:Connect(startMainDrag)

UserInputService.InputChanged:Connect(function(input)
	if not draggingMain then
		return
	end

	if input.UserInputType ~= Enum.UserInputType.MouseMovement
		and input.UserInputType ~= Enum.UserInputType.Touch then
		return
	end

	local delta = input.Position - dragStart

	targetPosition = UDim2.new(
		startPosition.X.Scale,
		startPosition.X.Offset + delta.X,
		startPosition.Y.Scale,
		startPosition.Y.Offset + delta.Y
	)
end)

UserInputService.InputEnded:Connect(function(input)
	if InputIsClick(input) then
		draggingMain = false
	end
end)

--========================================================--
-- STATUS DRAG
--========================================================--

local draggingStatus = false
local statusDragStart = Vector2.zero
local statusStartPosition = StatusBar.Position
local statusTargetPosition = StatusBar.Position

StatusBar.InputBegan:Connect(function(input)
	if not InputIsClick(input) then
		return
	end

	draggingStatus = true
	statusDragStart = input.Position
	statusStartPosition = StatusBar.Position
	statusTargetPosition = StatusBar.Position
end)

UserInputService.InputChanged:Connect(function(input)
	if not draggingStatus then
		return
	end

	if input.UserInputType ~= Enum.UserInputType.MouseMovement
		and input.UserInputType ~= Enum.UserInputType.Touch then
		return
	end

	local delta = input.Position - statusDragStart

	statusTargetPosition = UDim2.new(
		statusStartPosition.X.Scale,
		statusStartPosition.X.Offset + delta.X,
		statusStartPosition.Y.Scale,
		statusStartPosition.Y.Offset + delta.Y
	)
end)

UserInputService.InputEnded:Connect(function(input)
	if InputIsClick(input) then
		draggingStatus = false
	end
end)

--========================================================--
-- FLOATING BUTTON DRAG
--========================================================--

local draggingFloating = false
local floatingMoved = false
local floatingStart = Vector2.zero
local floatingStartPos = Floating.Position
local dragThreshold = 6

Floating.InputBegan:Connect(function(input)
	if not InputIsClick(input) then
		return
	end

	draggingFloating = true
	floatingMoved = false
	floatingStart = input.Position
	floatingStartPos = Floating.Position
end)

UserInputService.InputChanged:Connect(function(input)
	if not draggingFloating then
		return
	end

	if input.UserInputType ~= Enum.UserInputType.MouseMovement
		and input.UserInputType ~= Enum.UserInputType.Touch then
		return
	end

	local delta = input.Position - floatingStart

	if delta.Magnitude >= dragThreshold then
		floatingMoved = true
	end

	Floating.Position = UDim2.new(
		floatingStartPos.X.Scale,
		floatingStartPos.X.Offset + delta.X,

		floatingStartPos.Y.Scale,
		floatingStartPos.Y.Offset + delta.Y
	)
end)

UserInputService.InputEnded:Connect(function(input)
	if not InputIsClick(input) then
		return
	end

	draggingFloating = false
end)

