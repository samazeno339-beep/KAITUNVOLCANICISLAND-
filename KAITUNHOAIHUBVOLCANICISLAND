--========================================================
-- REMOTE FIND
--========================================================

local function GetRemotes()
	local Remotes = ReplicatedStorage:FindFirstChild("Remotes")

	if not Remotes then
		return nil, nil, "Remotes folder not found"
	end

	local DojoRemote = Remotes:FindFirstChild(
		"RF/InteractDragonQuest"
	)

	if DojoRemote
		and not DojoRemote:IsA("RemoteFunction") then

		DojoRemote = nil
	end

	-- Một số phiên bản có CommF_, một số script cộng đồng
	-- dùng CommF. Ưu tiên CommF_.
	local CommF = Remotes:FindFirstChild("CommF_")

	if not CommF then
		CommF = Remotes:FindFirstChild("CommF")
	end

	if CommF
		and not CommF:IsA("RemoteFunction") then

		CommF = nil
	end

	return DojoRemote, CommF, nil
end

--========================================================
-- DOJO READER
--========================================================

local function ReadCurrentBelt(DojoRemote)

	if not DojoRemote then
		return nil, "Dojo Remote Not Found"
	end

	local Success, Result = pcall(function()
		return DojoRemote:InvokeServer({
			NPC = "Dojo Trainer",
			Command = "RequestQuest",
		})
	end)

	if not Success then
		return nil, "Dojo Invoke Failed"
	end

	if type(Result) ~= "table" then
		return nil, "Dojo Response Invalid"
	end

	-- Chỉ đọc BeltName; không thực hiện quest.
	local BeltName = Result.BeltName

	if type(BeltName) ~= "string" then
		return nil, "BeltName Missing"
	end

	local BeltKey = Normalize(BeltName)

	if not BELT_BY_KEY[BeltKey] then
		return nil, "Unknown Belt: " .. tostring(BeltName)
	end

	return BeltName, nil
end

--========================================================
-- INVENTORY PARSER
--========================================================

local function ParseInventoryResult(RawInventory)
	local Owned = {}

	if type(RawInventory) ~= "table" then
		return Owned
	end

	for _, Entry in pairs(RawInventory) do
		if type(Entry) == "table" then
			local Name =
				Entry.Name
				or Entry.ItemName
				or Entry.NameItem
				or Entry.name
				or Entry.itemName

			if type(Name) == "string" then
				Owned[Normalize(Name)] = true
			end
		elseif type(Entry) == "string" then
			Owned[Normalize(Entry)] = true
		end
	end

	return Owned
end

local function HasOwned(Owned, ...)
	for Index = 1, select("#", ...) do
		local Name = select(Index, ...)

		if Owned[Normalize(Name)] then
			return true
		end
	end

	return false
end

--========================================================
-- INVENTORY CACHE
--========================================================

local InventoryCache = {
	Owned = {},
	LastRead = 0,
	Error = nil,
}

local function RefreshInventory(CommF)
	if not CommF then
		return false, "Inventory Remote Not Found"
	end

	local Now = os.clock()

	if Now - InventoryCache.LastRead
		< CONFIG.INVENTORY_REFRESH then

		return true, nil
	end

	InventoryCache.LastRead = Now

	local Success, RawInventory = pcall(function()
		return CommF:InvokeServer("getInventory")
	end)

	if not Success then
		InventoryCache.Error = "Inventory Invoke Failed"
		return false, InventoryCache.Error
	end

	if type(RawInventory) ~= "table" then
		InventoryCache.Error = "Inventory Response Invalid"
		return false, InventoryCache.Error
	end

	InventoryCache.Owned =
		ParseInventoryResult(RawInventory)

	InventoryCache.Error = nil

	return true, nil
end

--========================================================
-- PARSE PROGRESS
--========================================================

local function ReadBloxFruitsProgress()

	local Progress = EmptyProgress()

	local DojoRemote, CommF, RemoteError =
		GetRemotes()

	if RemoteError then
		Progress.Error = RemoteError
		return Progress
	end

	--====================================================
	-- DOJO
	--====================================================

	local BeltName, BeltError =
		ReadCurrentBelt(DojoRemote)

	if not BeltName then
		Progress.Error = BeltError
		return Progress
	end

	local CurrentBelt =
		BELT_BY_KEY[Normalize(BeltName)]

	if not CurrentBelt then
		Progress.Error = "Unknown Belt"
		return Progress
	end

	Progress.HighestBeltRank =
		CurrentBelt.Rank

	for _, Belt in ipairs(BELTS) do
		Progress.Belts[Belt.Key] =
			Belt.Rank <= CurrentBelt.Rank
	end

	--====================================================
	-- INVENTORY
	--====================================================

	local InventoryOK, InventoryError =
		RefreshInventory(CommF)

	-- Nếu chưa đọc inventory được thì trả về lỗi,
	-- tránh giả vờ Dragonstorm/Dragonheart = false.
	if not InventoryOK then
		Progress.Error = InventoryError
		return Progress
	end

	local Owned = InventoryCache.Owned

	Progress.Dragonstorm =
		HasOwned(
			Owned,
			"Dragonstorm",
			"Dragon Storm"
		)

	Progress.Dragonheart =
		HasOwned(
			Owned,
			"Dragonheart",
			"Dragon Heart"
		)

	Progress.DataValid = true

	Progress.Error = nil

	DebugPrint(
		"Belt:",
		BeltName,
		"Rank:",
		Progress.HighestBeltRank,
		"Dragonstorm:",
		Progress.Dragonstorm,
		"Dragonheart:",
		Progress.Dragonheart
	)

	return Progress
end

--========================================================
-- NEXT OBJECTIVE
--========================================================

local function GetNextObjective(Progress)

	if type(Progress) ~= "table" then
		return "Data Read Failed / Không đọc được dữ liệu"
	end

	if not Progress.DataValid then
		return "Data Read Failed / Không đọc được dữ liệu"
	end

	-- Tìm đai đầu tiên còn thiếu
	for _, Belt in ipairs(BELTS) do

		if not Progress.Belts[Belt.Key] then

			return
				"Getting "
				.. Belt.English
				.. " / Đang lấy "
				.. Belt.VN
				.. "..."
		end

	end

	-- Đủ Black
	if not Progress.Dragonstorm then
		return
			"Getting Dragonstorm / Đang lấy Dragonstorm..."
	end

	if not Progress.Dragonheart then
		return
			"Getting Dragonheart / Đang lấy Dragonheart..."
	end

	return "Complete / Đã hoàn thành!"
end

