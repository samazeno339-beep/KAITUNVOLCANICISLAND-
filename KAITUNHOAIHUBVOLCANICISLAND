--========================================================
-- AUTO SELECT MARINES
--========================================================

task.spawn(function()

	if not game:IsLoaded() then
		game.Loaded:Wait()
	end

	SetStatus("Waiting for Marines...")

	local Remotes = ReplicatedStorage:WaitForChild("Remotes", 30)

	if not Remotes then
		warn("HOÀI HUB: Remotes not found")
		SetStatus("Marines Failed")
		return
	end

	local CommF_ = Remotes:WaitForChild("CommF_", 30)

	if not CommF_ then
		warn("HOÀI HUB: CommF_ not found")
		SetStatus("Marines Failed")
		return
	end

	-- Nếu đã có team thì không cần chọn
	if LocalPlayer.Team then

		if string.lower(LocalPlayer.Team.Name) == "marines" then
			SetStatus("Marines Selected")
		else
			SetStatus("Team Already Selected")
		end

		return
	end

	SetStatus("Selecting Marines...")

	local Deadline = os.clock() + 15

	while LocalPlayer.Parent
		and LocalPlayer.Team == nil
		and os.clock() < Deadline do

		local Success, Result = pcall(function()

			return CommF_:InvokeServer(
				"SetTeam",
				"Marines"
			)

		end)

		if not Success then
			warn("HOÀI HUB: SetTeam failed:", Result)
		end

		task.wait(0.5)
	end

	if LocalPlayer.Team then

		if string.lower(LocalPlayer.Team.Name) == "marines" then
			SetStatus("Marines Selected")
			print("HOÀI HUB: Marines Selected")
		else
			SetStatus("Team Already Selected")
		end

	else

		SetStatus("Marine Select Failed")
		warn("HOÀI HUB: Could not select Marines")

	end

end)

