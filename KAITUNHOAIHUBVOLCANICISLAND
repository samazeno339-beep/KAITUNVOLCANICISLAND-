local LastStatus = nil

local function ApplyStatus(Text)

	if LastStatus == Text then
		return
	end

	LastStatus = Text

	SetStatus(Text)
end

--========================================================
-- UPDATE STATUS
--========================================================

local function UpdateStatus()

	local Data =
		ReadBloxFruitsProgress()

	-- Không đọc được dữ liệu Dojo
	if not Data.CurrentBelt then

		ApplyStatus(
			"Checking Dojo... / Đang kiểm tra Dojo..."
		)

		return
	end

	local Rank =
		Data.HighestBeltRank

	--====================================================
	-- CÒN ĐAI
	--====================================================

	if Rank > 0
		and Rank < #Belts then

		local NextBelt =
			Belts[Rank + 1]

		ApplyStatus(
			"Getting "
			.. NextBelt.English
			.. " / Đang lấy "
			.. NextBelt.VN
			.. "..."
		)

		return
	end

	--====================================================
	-- BLACK -> DRAGONSTORM
	--====================================================

	if Rank >= 8 then

		if not Data.DragonStorm then

			ApplyStatus(
				"Getting Dragonstorm / Đang lấy Dragonstorm..."
			)

			return
		end

		--================================================
		-- DRAGONSTORM -> DRAGONHEART
		--================================================

		if not Data.DragonHeart then

			ApplyStatus(
				"Getting Dragonheart / Đang lấy Dragonheart..."
			)

			return
		end

		--================================================
		-- COMPLETE
		--================================================

		ApplyStatus(
			"Complete / Đã hoàn thành!"
		)

		return
	end

	ApplyStatus(
		"Checking Dojo... / Đang kiểm tra Dojo..."
	)
end

