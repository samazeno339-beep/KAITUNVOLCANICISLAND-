--========================================================--
-- SAFE REMOTE HELPERS
--========================================================--

local function FindCommF()
    local rep = game:GetService("ReplicatedStorage")
    local remotes = rep:FindFirstChild("Remotes")
    local comm = remotes and remotes:FindFirstChild("CommF_")

    if comm and comm:IsA("RemoteFunction") then
        return comm
    end

    return nil
end

local function SafeInvoke(comm, command)
    if not comm then
        return nil
    end

    local ok, result = pcall(function()
        return comm:InvokeServer(command)
    end)

    if ok then
        return result
    end

    return nil
end

local function ReadNumber(tbl, names)
    if type(tbl) ~= "table" then
        return nil
    end

    for _, name in ipairs(names) do
        local value = tbl[name]

        if type(value) == "number" then
            return value
        end

        if type(value) == "string" then
            local number = tonumber(value)
            if number then
                return number
            end
        end
    end

    return nil
end

--========================================================--
-- ACCOUNT STATUS
--========================================================--

local function ScanAccountStatus()
    local level, beli, fragments

    -- Prefer client-visible leaderstats/values.
    local containers = {
        Player,
        Player:FindFirstChild("leaderstats"),
        Player:FindFirstChild("Data"),
    }

    local function readNames(names)
        for _, container in ipairs(containers) do
            if container then
                for _, name in ipairs(names) do
                    local obj = container:FindFirstChild(name, true)
                    if obj and obj:IsA("ValueBase") then
                        local ok, value = pcall(function()
                            return obj.Value
                        end)

                        if ok then
                            return value
                        end
                    end
                end
            end
        end

        for _, name in ipairs(names) do
            local attr = Player:GetAttribute(name)
            if attr ~= nil then
                return attr
            end
        end

        return nil
    end

    level = readNames({"Level", "Lv", "LevelData"})
    beli = readNames({"Beli", "Money", "BeliCount"})
    fragments = readNames({"Fragments", "Fragment"})

    StatsText.Text =
        "Name: " .. Player.Name ..
        "\nLevel: " .. tostring(level or "NOT READ") ..
        "\nBeli: " .. tostring(beli or "NOT READ") ..
        "\nFragments: " .. tostring(fragments or "NOT READ")
end

