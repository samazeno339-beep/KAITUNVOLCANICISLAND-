end)

RunService.RenderStepped:Connect(function()
	if not CONFIG.AimAssist then
		return
	end

	local target = GetNearestPlayer()

	if target then
		Camera.CFrame = Camera.CFrame:Lerp(
			CFrame.lookAt(Camera.CFrame.Position, target.Position),
			CONFIG.AimSmooth
		)
	end
end)

--====================================================--
-- FLY
--====================================================--

local FlyConnection

local function StartFly()
	local char = LP.Character
	if not char then
		return
	end

	local root = char:FindFirstChild("HumanoidRootPart")
	if not root then
		return
	end

	local Velocity = Instance.new("BodyVelocity")
	Velocity.Name = "HoaiFlyVelocity"
	Velocity.MaxForce = Vector3.new(
		math.huge,
		math.huge,
		math.huge
	)
	Velocity.Velocity = Vector3.zero
	Velocity.Parent = root

	FlyConnection = RunService.RenderStepped:Connect(function()
		if not CONFIG.Fly or not root.Parent then
			return
		end

		local move =
			workspace.CurrentCamera.CFrame.LookVector
			* CONFIG.FlySpeed

		if UserInputService:IsKeyDown(Enum.KeyCode.W) == false
			and UserInputService:IsKeyDown(Enum.KeyCode.S) == false then

			move = Vector3.zero
		end

		if UserInputService:IsKeyDown(Enum.KeyCode.S) then
			move = -workspace.CurrentCamera.CFrame.LookVector
				* CONFIG.FlySpeed
		end

		if UserInputService:IsKeyDown(Enum.KeyCode.A) then
			move -= workspace.CurrentCamera.CFrame.RightVector
				* CONFIG.FlySpeed
		end

		if UserInputService:IsKeyDown(Enum.KeyCode.D) then
			move += workspace.CurrentCamera.CFrame.RightVector
				* CONFIG.FlySpeed
		end

		if UserInputService:IsKeyDown(Enum.KeyCode.Space) then
			move += Vector3.new(0, CONFIG.FlySpeed, 0)
		end

		if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then
			move -= Vector3.new(0, CONFIG.FlySpeed, 0)
		end

		Velocity.Velocity = move
	end)
end

local function StopFly()
	if FlyConnection then
		FlyConnection:Disconnect()
		FlyConnection = nil
	end

	local char = LP.Character
	if char then
		local root = char:FindFirstChild("HumanoidRootPart")

		if root then
			local v = root:FindFirstChild("HoaiFlyVelocity")

			if v then
				v:Destroy()
			end
		end
	end
end

CreateToggle("Fly", function(value)
	CONFIG.Fly = value

	if value then
		StartFly()
	else
		StopFly()
	end
end)

--====================================================--
-- AUTO FARM
--====================================================--

local function FindNearestNPC()
	local char = LP.Character
	local root =
		char and char:FindFirstChild("HumanoidRootPart")

	if not root then
		return nil
	end

	local nearest
	local distance = math.huge

	for _, obj in ipairs(workspace:GetDescendants()) do

		if obj:IsA("Model")
			and obj ~= char
			and obj:FindFirstChildOfClass("Humanoid")
			and obj:FindFirstChild("HumanoidRootPart")
			and not Players:GetPlayerFromCharacter(obj) then

			local hum = obj:FindFirstChildOfClass("Humanoid")

			if hum and hum.Health > 0 then

				local d =
					(root.Position - obj.HumanoidRootPart.Position).Magnitude

				if d < distance then
					distance = d
					nearest = obj
				end
			end
		end
	end

	return nearest
end

CreateToggle("Auto Farm", function(value)
	CONFIG.AutoFarm = value
end)

task.spawn(function()
	while task.wait(0.15) do

		if CONFIG.AutoFarm then

			local char = LP.Character
			local root =
				char and char:FindFirstChild("HumanoidRootPart")

			if root then

				local npc = FindNearestNPC()

				if npc and npc:FindFirstChild("HumanoidRootPart") then

					local target =
						npc.HumanoidRootPart.Position
						+ Vector3.new(0, 3, 5)

					root.CFrame = CFrame.lookAt(
						target,
						npc.HumanoidRootPart.Position
					)

					--// Đây chỉ là phần di chuyển.
					--// Hệ thống damage/attack nên được xử lý
					--// bằng RemoteEvent của chính game bạn.
				end
			end
		end
	end
end)

--====================================================--
-- FIX LAG
--====================================================--

local function ApplyFixLag()
	for _, obj in ipairs(workspace:GetDescendants()) do

		if obj:IsA("ParticleEmitter")
			or obj:IsA("Trail")
			or obj:IsA("Beam") then

			obj.Enabled = false

		elseif obj:IsA("Smoke")
			or obj:IsA("Fire")
			or obj:IsA("Sparkles") then

			obj.Enabled = false

		elseif obj:IsA("BasePart") then
			-- giảm tải render
			if obj.Material ~= Enum.Material.Glass then
				obj.CastShadow = false
			end
		end
	end

	for _, obj in ipairs(Lighting:GetChildren()) do

		if obj:IsA("PostEffect") then
			obj.Enabled = false
		end
	end
end

CreateToggle("Fix Lag", function(value)
	CONFIG.FixLag = value

	if value then
		ApplyFixLag()
	end
end)

